# Copy to .env.local (ignored by Git). All values are server-side.
# Exact origin, no path. Production requires HTTPS.
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Cloud Storage bucket used by publish. Not a secret.
# Writes use Application Default Credentials. Do not put a service-account JSON key here.
GCS_BUCKET=

# Hosted container only. The Cloud Run service keeps one SQLite file here, and
# PUBLISHER_REPLICA=gcs copies it to gs://$GCS_BUCKET/_publisher/working-set.sqlite
# so the next deploy can restore it. Leave both unset on a laptop.
# PUBLISHER_DATABASE_PATH=/data/publisher.sqlite
# PUBLISHER_REPLICA=gcs

# Test-only in-memory bucket. Ignored when NODE_ENV=production.
# PUBLISHER_STORAGE=memory

# F15. Comma-separated verified @anywhere.co emails that stay admins.
# Anyone else must be added on the Access screen. An empty list with an empty
# access table denies every account in production.
# AUTH_ADMIN_EMAILS=

# Optional. AI translation uses Application Default Credentials and this project.
# When translation is unavailable, the new language stays in English.
# GOOGLE_CLOUD_PROJECT=

# The verified anywhere.co email restriction is fixed in server code.
# Local only: set to true to allow any verified Google email (personal accounts).
# Ignored when NODE_ENV=production. Never set this in a real deployment.
# AUTH_ALLOW_ANY_VERIFIED_EMAIL=true
